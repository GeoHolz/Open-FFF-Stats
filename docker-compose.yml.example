version: '3.8'

services:
  # Service PHP-FPM
  php:
    image: php:8.3-fpm # Utiliser une version récente de PHP
    user: "1000:1000"
    volumes:
      - ./www:/var/www/html # Monte votre code dans le conteneur
    ports:
      - "9000" # Expose le port FPM (interne, Nginx y accède)
    restart: unless-stopped
  # Service Nginx (Serveur web)
  nginx:
    image: nginx:stable-alpine
    ports:
      - "8085:80" # Mappe le port 8080 de l'hôte au port 80 du conteneur
    volumes:
      - ./www:/var/www/html # Monte le même code pour Nginx
      - ./nginx.conf:/etc/nginx/conf.d/default.conf # Utilise notre configuration Nginx
    depends_on:
      - php # Assure que PHP démarre avant Nginx
    restart: unless-stopped
